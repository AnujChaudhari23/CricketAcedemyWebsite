# Normalise line endings to LF in the repo; check out as-is on all platforms
* text=auto eol=lf

# Force binary treatment for actual binary assets
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary
*.eot  binary
*.mp4  binary
*.mp3  binary
*.pdf  binary
*.zip  binary
